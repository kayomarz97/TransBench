# TransBench environment configuration (copy to .env and fill in)

# Anthropic key used by the engine's own LLM calls (BYOK). This is independent
# of Claude Science, which is only the MCP client invoking the tool.
ANTHROPIC_API_KEY=

# Optional: raises PubMed rate limits (maps to Iatronix settings.pubmed_api_key).
PUBMED_API_KEY=

# Multi-database retrieval (Phase 9, src/transbench/search_sources.py). Europe PMC
# (general scientific literature incl. preprints; the primary source that grounds
# mechanism hypotheses the clinical fetcher misses) needs NO key and is on by
# default. Semantic Scholar is OPTIONAL — its keyless pool 429s immediately, so
# it is SKIPPED unless a key is set here (free key: https://www.semanticscholar.org/product/api).
SEMANTIC_SCHOLAR_API_KEY=
# Set any to 0/false to disable a backend (both default on when reachable/keyed):
# TRANSBENCH_ENABLE_EUROPEPMC=1
# TRANSBENCH_ENABLE_SEMANTIC_SCHOLAR=1

# Force deterministic LLM clients. create_llm() has no temperature arg -- it
# builds clients at settings.llm_temperature (Iatronix default 0.2), so this
# env var (read by the reused Iatronix Settings) plus .bind(temperature=0) on
# every client (belt-and-suspenders, see BUILD_SPEC §0.7) is required.
LLM_TEMPERATURE=0

# Prevents Python from writing .pyc/__pycache__ during imports -- required so
# that importing the read-only, editable-installed Iatronix backend never
# writes bytecode into the Iatronix tree (baseline-diff guard, BUILD_SPEC §0.1).
PYTHONDONTWRITEBYTECODE=1
